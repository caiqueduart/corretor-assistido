# Copie para .env e ajuste. Só ANTHROPIC_API_KEY e as credenciais do admin costumam mudar.
ADDR=:8080
DB_PATH=./dados/corretor.db

# Correção por IA (sem a chave, só a correção simulada fica disponível)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VERSION=2026-10-21
CORRECAO_CONCORRENCIA=4
CORRECAO_TIMEOUT=150s

# Primeiro administrador (criado só quando o banco está vazio).
# Sem ADMIN_SENHA, uma senha é gerada e aparece uma única vez no log.
ADMIN_EMAIL=admin@escola.exemplo
ADMIN_SENHA=
ADMIN_NOME=Administrador

SESSAO_DURACAO=12h
MAX_UPLOAD_MB=10
# Origens da interface web, separadas por vírgula (ex.: http://localhost:5173)
CORS_ORIGENS=
# Pasta com a interface estática, servida em / (opcional)
STATIC_DIR=
# Carrega os 8 textos do roteiro de demonstração ao iniciar
SEED_EXEMPLOS=false
