{
    "name": "corretor-assistido",
    "private": true,
    "description": "Corretor assistido de produções textuais (POC 1.3)",
    "scripts": {
        "start": "npm run start --workspace frontend",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "format": "prettier --write \"apps/**/*.{ts,html,scss,json,md}\""
    },
    "devDependencies": {
        "prettier": "^3.8.1"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "npm@11.5.1",
    "workspaces": [
        "apps/*"
    ],
    "overrides": {
        "vite": "7.3.7"
    }
}
